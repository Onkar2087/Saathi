# ---------- Gemma (open-weight model) ----------
# Any OpenAI-compatible endpoint serving Gemma. Defaults to Ollama on this machine.
#   Local laptop:          http://localhost:11434/v1
#   DigitalOcean Serverless: https://inference.do-ai.run/v1  (MODEL_NAME=gemma-4-31B-it,
#                            MODEL_API_KEY=<Model Access Key>, MODEL_SUPPORTS_TOOLS=true, EMBED_MODEL_NAME=none)
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=gemma3:4b
MODEL_API_KEY=ollama
# Set to true only if your Gemma build supports native tool calling
# (enables Mastra tools + working memory). Off = context is injected into the prompt instead.
MODEL_SUPPORTS_TOOLS=false
# Embedding model for help-note search (Atlas Vector Search). EmbeddingGemma via Ollama.
EMBED_MODEL_NAME=embeddinggemma

# ---------- MongoDB Atlas (optional: progress, memory, vector search) ----------
MONGODB_URI=
MONGODB_DB_NAME=saathi

# ---------- ElevenLabs (optional: warm voice + speech-to-text) ----------
ELEVENLABS_API_KEY=
# A calm multilingual voice. Pick one from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# ---------- Sentry (optional: agent tracing) ----------
SENTRY_DSN=
